# Base API (tanpa path). OCR = {BASE}/api/v2, auth = {BASE}/api/v1/...
VITE_API_BASE_URL=https://splitbill-api.nrarivin.online
# Legacy (opsional): kalau hanya ini yang diisi, /api/v2 akan di-strip jadi base
VITE_API_URL=https://splitbill-api.nrarivin.online/api/v2

# Google OAuth Web Client ID (sama dengan GOOGLE_CLIENT_ID di backend)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

PORT=8082
